# Copy to .env and adjust.  cp .env.example .env

# --- Traffic identification (program compliance) ---
# Your researcher handle. Sent as User-Agent and X-Bug-Bounty header so programs
# can attribute your recon traffic. Many programs REQUIRE this.
HANDLE=your-handle
# Optional contact appended to the User-Agent (leave blank if you prefer not to).
CONTACT=

# --- Throttling (be a good neighbour; avoid looking like an attack) ---
CONCURRENCY=5            # parallel pages during crawl/screenshot
REQ_DELAY_MS=400         # delay added per request
NAV_TIMEOUT_S=25         # per-page navigation timeout
HTTPX_RATELIMIT=50       # httpx requests/sec cap

# --- Enumeration ---
AMASS_ENABLED=true
AMASS_TIMEOUT_MIN=10     # cap amass passive run so re-runs stay fast

# --- Internals (leave as-is unless you change the compose network) ---
# recon shares obscura's network namespace, so Obscura is reachable on localhost.
OBSCURA_WS=ws://127.0.0.1:9222
